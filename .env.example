# SkillBridge Environment Configuration

PORT=3000
NODE_ENV=development

# JWT Secret for student authentication (change in production)
JWT_SECRET=skillbridge_super_secret_jwt_key_2026

# Optional: Supabase Database (if unset, SkillBridge runs in zero-dependency in-memory mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: SMTP Server for Real Email OTP delivery (if unset, OTP codes print to server console and API response)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SkillBridge <no-reply@campus.edu>"

# Optional: Custom API URL when hosting frontend and backend on separate domains
VITE_API_URL=
