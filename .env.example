# HackSaath Environment Configuration
# Copy this file to .env and configure for your local environment

PORT=3000
NODE_ENV=development

# JWT Secret for student authentication (set a cryptographically secure key in production)
JWT_SECRET=your_jwt_secret_change_in_production

# Optional: Supabase Database (if unset, HackSaath runs in zero-dependency in-memory mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: SMTP Server for Real Email OTP delivery (if unset, OTP codes print to server console and API response)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HackSaath <no-reply@hacksaath.in>"

# Optional: Custom API URL when hosting frontend and backend on separate domains
VITE_API_URL=

